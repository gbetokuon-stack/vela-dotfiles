#!/usr/bin/env python3
# =============================================================================
#  vela-ctl — Live Hyprland 0.57.2 (Lua API) & Vela Rice Tuning Controller
#  Controls: blur, blur_size, blur_passes, term_opacity, rounding, gaps_in,
#            gaps_out, border_size, anim_enabled, anim_preset, vrr_enabled
# =============================================================================
import json
import os
import re
import subprocess
import sys

CACHE_FILE = os.path.expanduser("~/.cache/vela/settings.json")
KITTY_CONF = os.path.expanduser("~/.config/kitty/kitty.conf")

DEFAULTS = {
    "blur_enabled": True,
    "blur_size": 7,
    "blur_passes": 3,
    "term_opacity": 68,       # percentage 45..100
    "rounding": 18,
    "gaps_in": 6,
    "gaps_out": 14,
    "border_size": 2,
    "anim_enabled": True,
    "anim_preset": "spring",  # "spring" | "snappy" | "smooth" | "off"
    "vrr_enabled": True,      # maps to vrr = 2 (fullscreen only -> desktop locked 144Hz)
    "slideshow_mins": 0,      # 0 = Off, else auto-cycle wallpaper every N minutes
    "layout_mode": "dwindle", # "dwindle" | "scrolling" | "master"
}


def load_settings():
    os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
    cfg = dict(DEFAULTS)
    if os.path.exists(CACHE_FILE):
        try:
            with open(CACHE_FILE) as f:
                cfg.update(json.load(f))
        except Exception:
            pass
    return cfg


def save_settings(cfg):
    os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
    with open(CACHE_FILE, "w") as f:
        json.dump(cfg, f, indent=2)


def apply_settings(cfg):
    blur_en = "true" if cfg.get("blur_enabled", True) else "false"
    blur_sz = int(cfg.get("blur_size", 7))
    blur_ps = int(cfg.get("blur_passes", 3))
    rounding = int(cfg.get("rounding", 18))
    gaps_in = int(cfg.get("gaps_in", 6))
    gaps_out = int(cfg.get("gaps_out", 14))
    border = int(cfg.get("border_size", 2))
    preset = cfg.get("anim_preset", "spring")
    anim_en = "false" if (not cfg.get("anim_enabled", True) or preset == "off") else "true"
    # VRR = 2 (fullscreen only) keeps desktop animations locked at 144Hz with zero idle-ramp stutter!
    vrr = 2 if cfg.get("vrr_enabled", True) else 0
    layout_mode = str(cfg.get("layout_mode", "dwindle"))
    if layout_mode not in ("dwindle", "scrolling", "master"):
        layout_mode = "dwindle"

    lua_parts = [
        f"hl.config({{"
        f'general={{gaps_in={gaps_in},gaps_out={gaps_out},border_size={border},layout="{layout_mode}"}},'
        f"decoration={{rounding={rounding},blur={{enabled={blur_en},size={blur_sz},passes={blur_ps}}}}},"
        f"animations={{enabled={anim_en}}},"
        f"misc={{vrr={vrr}}}"
        f"}})"
    ]

    if anim_en == "true":
        if preset == "snappy":
            lua_parts.extend([
                'hl.animation({leaf="windows",enabled=true,speed=3.4,bezier="velaSnappy"})',
                'hl.animation({leaf="windowsIn",enabled=true,speed=3.2,bezier="velaSnappy",style="popin 90%"})',
                'hl.animation({leaf="windowsOut",enabled=true,speed=2.4,bezier="velaFluid",style="popin 92%"})',
                'hl.animation({leaf="windowsMove",enabled=true,speed=3.4,bezier="velaSnappy"})',
                'hl.animation({leaf="workspaces",enabled=true,speed=3.2,bezier="velaWorkspace",style="slide"})',
                'hl.animation({leaf="workspacesIn",enabled=true,speed=3.2,bezier="velaWorkspace",style="slide"})',
                'hl.animation({leaf="workspacesOut",enabled=true,speed=3.2,bezier="velaWorkspace",style="slide"})',
            ])
        elif preset == "smooth":
            lua_parts.extend([
                'hl.animation({leaf="windows",enabled=true,speed=5.6,spring="velaMoveSpring"})',
                'hl.animation({leaf="windowsIn",enabled=true,speed=5.4,spring="velaMoveSpring",style="popin 88%"})',
                'hl.animation({leaf="windowsOut",enabled=true,speed=4.2,bezier="velaSilk",style="popin 90%"})',
                'hl.animation({leaf="windowsMove",enabled=true,speed=5.8,spring="velaMoveSpring"})',
                'hl.animation({leaf="workspaces",enabled=true,speed=5.4,bezier="velaSilk",style="slide"})',
                'hl.animation({leaf="workspacesIn",enabled=true,speed=5.4,bezier="velaSilk",style="slide"})',
                'hl.animation({leaf="workspacesOut",enabled=true,speed=5.4,bezier="velaSilk",style="slide"})',
            ])
        else:  # "spring" (144Hz fluid critically-damped default)
            lua_parts.extend([
                'hl.animation({leaf="windows",enabled=true,speed=4.4,spring="velaSpring"})',
                'hl.animation({leaf="windowsIn",enabled=true,speed=4.2,spring="velaSpring",style="popin 88%"})',
                'hl.animation({leaf="windowsOut",enabled=true,speed=3.0,bezier="velaFluid",style="popin 90%"})',
                'hl.animation({leaf="windowsMove",enabled=true,speed=4.6,spring="velaMoveSpring"})',
                'hl.animation({leaf="workspaces",enabled=true,speed=4.2,bezier="velaWorkspace",style="slide"})',
                'hl.animation({leaf="workspacesIn",enabled=true,speed=4.2,bezier="velaWorkspace",style="slide"})',
                'hl.animation({leaf="workspacesOut",enabled=true,speed=4.2,bezier="velaWorkspace",style="slide"})',
            ])

    subprocess.run(
        ["hyprctl", "eval", "; ".join(lua_parts)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    # Update Kitty background_opacity
    op_float = round(max(0.40, min(1.0, int(cfg.get("term_opacity", 68)) / 100.0)), 2)
    if os.path.exists(KITTY_CONF):
        try:
            text = open(KITTY_CONF).read()
            new_text = re.sub(
                r"^background_opacity\s+.*$",
                f"background_opacity         {op_float:.2f}",
                text,
                flags=re.M,
            )
            if new_text != text:
                with open(KITTY_CONF, "w") as f:
                    f.write(new_text)
                subprocess.run(["pkill", "-SIGUSR1", "kitty"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass


def main():
    cfg = load_settings()
    if len(sys.argv) <= 1 or sys.argv[1] == "get":
        print(json.dumps(cfg))
        return

    cmd = sys.argv[1]
    if cmd == "apply":
        apply_settings(cfg)
        print(json.dumps(cfg))
    elif cmd == "reset":
        cfg = dict(DEFAULTS)
        save_settings(cfg)
        apply_settings(cfg)
        print(json.dumps(cfg))
    elif cmd == "set" and len(sys.argv) >= 4:
        k, v = sys.argv[2], sys.argv[3]
        if k in DEFAULTS:
            if isinstance(DEFAULTS[k], bool):
                cfg[k] = v.lower() in ("1", "true", "yes", "on")
            elif isinstance(DEFAULTS[k], int):
                cfg[k] = int(float(v))
            else:
                cfg[k] = v
            save_settings(cfg)
            apply_settings(cfg)
        print(json.dumps(cfg))


if __name__ == "__main__":
    main()
