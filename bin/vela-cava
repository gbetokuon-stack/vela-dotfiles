#!/usr/bin/env bash
# Lightweight raw Cava spectrum streamer for Vela Quickshell (12 bars, 0..100)
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

CFG="/tmp/vela-cava-raw.conf"
cat > "$CFG" <<'EOF'
[general]
framerate = 40
bars = 12
autosens = 1
sensitivity = 110

[input]
method = pipewire
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
bar_delimiter = 59

[smoothing]
monstercat = 1
waves = 0
gravity = 120
noise_reduction = 72
EOF

exec cava -p "$CFG"
