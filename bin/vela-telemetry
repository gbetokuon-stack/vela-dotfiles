#!/usr/bin/env python3
# Vela Fast Hardware Telemetry JSON for HP Victus (AMD Ryzen 7 7445HS + NVIDIA RTX 4050 Mobile)
# Zero-sleep, sysfs-native, RTD3-safe: avoids spawning slow subprocesses or waking RTX 4050!
import glob
import json
import os
import socket
import subprocess
import time

UID = os.getuid()
RUN_DIR = f"/run/user/{UID}"
CPU_STATE_FILE = f"{RUN_DIR}/vela-cpu.json"
GPU_CACHE_FILE = f"{RUN_DIR}/vela-gpu-cache.json"


def read_file(p, default=""):
    try:
        with open(p) as f:
            return f.read().strip()
    except Exception:
        return default


# 1. CPU usage (zero-sleep delta across polling intervals via /run/user/1000/vela-cpu.json)
def get_cpu_pct():
    try:
        parts = read_file("/proc/stat").splitlines()[0].split()[1:]
        nums = [int(x) for x in parts]
        idle = nums[3] + (nums[4] if len(nums) > 4 else 0)
        total = sum(nums)
    except Exception:
        return 0

    prev_idle, prev_total = 0, 0
    try:
        with open(CPU_STATE_FILE) as f:
            st = json.load(f)
            prev_idle = int(st.get("idle", 0))
            prev_total = int(st.get("total", 0))
    except Exception:
        pass

    try:
        with open(CPU_STATE_FILE, "w") as f:
            json.dump({"idle": idle, "total": total}, f)
    except Exception:
        pass

    dt = total - prev_total
    if dt <= 0 or prev_total == 0:
        return 0
    return max(0, min(100, round(100.0 * (1.0 - (idle - prev_idle) / dt))))


cpu_pct = get_cpu_pct()

# 2. CPU temp (AMD k10temp)
cpu_temp = 0
for hw in glob.glob("/sys/class/hwmon/hwmon*"):
    name = read_file(f"{hw}/name")
    if name in ("k10temp", "zenpower", "acpitz"):
        t = read_file(f"{hw}/temp1_input")
        if t.isdigit():
            cpu_temp = round(int(t) / 1000.0)
            if name == "k10temp":
                break

# 3. RAM
mem = {}
for line in read_file("/proc/meminfo").splitlines():
    if ":" in line:
        k, v = line.split(":", 1)
        mem[k] = int(v.strip().split()[0])
mem_total = mem.get("MemTotal", 1)
mem_avail = mem.get("MemAvailable", 0)
mem_used_gb = round((mem_total - mem_avail) / 1048576.0, 1)
mem_total_gb = round(mem_total / 1048576.0, 1)
mem_pct = round(100.0 * (mem_total - mem_avail) / max(1, mem_total))

# 4. NVIDIA RTX 4050 RTD3-safe status (cached 30s when active so nvidia-smi doesn't block RTD3 sleep!)
gpu_pci = "/sys/bus/pci/devices/0000:01:00.0"
gpu_rt = read_file(f"{gpu_pci}/power/runtime_status", "unknown")
gpu_driver = (
    os.path.basename(os.path.realpath(f"{gpu_pci}/driver"))
    if os.path.exists(f"{gpu_pci}/driver")
    else "none"
)
gpu_state = "Sleep"
gpu_temp = 0
gpu_util = 0
gpu_vram = "0G"

if gpu_driver == "nvidia":
    if gpu_rt == "suspended":
        gpu_state = "D3cold"
    else:
        gpu_state = "Active"
        now = time.time()
        cached = None
        try:
            with open(GPU_CACHE_FILE) as f:
                c = json.load(f)
                if now - c.get("ts", 0) < 30.0:
                    cached = c
        except Exception:
            pass

        if cached:
            gpu_temp = cached.get("temp", 0)
            gpu_util = cached.get("util", 0)
            gpu_vram = cached.get("vram", "0G")
        else:
            try:
                out = (
                    subprocess.check_output(
                        [
                            "nvidia-smi",
                            "--query-gpu=temperature.gpu,utilization.gpu,memory.used,memory.total",
                            "--format=csv,noheader,nounits",
                        ],
                        stderr=subprocess.DEVNULL,
                        timeout=0.8,
                    )
                    .decode()
                    .strip()
                )
                parts = [p.strip() for p in out.split(",")]
                if len(parts) >= 4:
                    gpu_temp = int(parts[0])
                    gpu_util = int(parts[1])
                    gpu_vram = f"{round(int(parts[2])/1024, 1)}/{round(int(parts[3])/1024, 0):.0f}G"
                    with open(GPU_CACHE_FILE, "w") as f:
                        json.dump(
                            {"ts": now, "temp": gpu_temp, "util": gpu_util, "vram": gpu_vram},
                            f,
                        )
            except Exception:
                pass
elif gpu_driver == "nouveau":
    gpu_state = "Nouveau"

krel = os.uname().release
nvidia_pkg_installed = os.path.exists(f"/usr/lib/modules/{krel}/extramodules/nvidia.ko.zst") or os.path.exists(
    f"/usr/lib/modules/{krel}/updates/dkms/nvidia.ko.zst"
)
nvidia_mod_indexed = True if gpu_driver == "nvidia" else False
if not nvidia_mod_indexed:
    try:
        with open(f"/usr/lib/modules/{krel}/modules.dep") as f:
            nvidia_mod_indexed = "nvidia.ko" in f.read()
    except Exception:
        pass

# 5. Battery
bat_cap = int(read_file("/sys/class/power_supply/BAT0/capacity", "100") or "100")
bat_status = read_file("/sys/class/power_supply/BAT0/status", "Unknown")
bat_power_uw = read_file("/sys/class/power_supply/BAT0/power_now", "0")
bat_watts = round(int(bat_power_uw) / 1e6, 1) if bat_power_uw.isdigit() else 0.0

# 6. Power profile (direct sysfs read in 0.01ms instead of spawning python powerprofilesctl)
raw_prof = read_file("/sys/firmware/acpi/platform_profile", "balanced")
if raw_prof == "low-power":
    profile = "power-saver"
elif raw_prof in ("performance", "balanced", "power-saver"):
    profile = raw_prof
else:
    profile = "balanced"

# 7. Brightness (amdgpu_bl2)
bright = 100
for bl in glob.glob("/sys/class/backlight/*"):
    try:
        cur = int(read_file(f"{bl}/brightness", "100"))
        mx = int(read_file(f"{bl}/max_brightness", "255"))
        bright = round(100.0 * cur / max(1, mx))
        break
    except Exception:
        pass

# 8. Network (direct sysfs read in 0.05ms)
net_type = "offline"
net_name = "Offline"
for npath in sorted(glob.glob("/sys/class/net/*")):
    iface = os.path.basename(npath)
    if iface == "lo":
        continue
    if read_file(f"{npath}/operstate") == "up":
        if iface.startswith("wl"):
            net_type = "wifi"
            net_name = iface
        else:
            net_type = "ethernet"
            net_name = "Wired"
        break

# 9. Bluetooth (direct sysfs rfkill check in 0.02ms)
bt_on = False
for rfk in glob.glob("/sys/class/rfkill/rfkill*"):
    if read_file(f"{rfk}/type") == "bluetooth":
        bt_on = read_file(f"{rfk}/state") == "1"
        break

# 10. Night Light & Game Mode
night_light = False
for p in glob.glob("/proc/[0-9]*/comm"):
    if read_file(p) == "hyprsunset":
        night_light = True
        break
game_mode = os.path.exists(os.path.expanduser("~/.cache/vela/gamemode"))

# 11. Input Method (Fcitx5 EN/VN)
im_engine = ""
try:
    im_raw = (
        subprocess.check_output(["fcitx5-remote", "-n"], stderr=subprocess.DEVNULL, timeout=0.3)
        .decode()
        .strip()
        .lower()
    )
    if any(k in im_raw for k in ("unikey", "bamboo", "vi")):
        im_engine = "VN"
    elif im_raw:
        im_engine = "EN"
except Exception:
    im_engine = ""

# 12. Active Hyprland Tiling Layout (direct UNIX socket query in 0.1ms instead of spawning hyprctl)
layout_mode = "dwindle"
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
if sig:
    sock_path = f"{RUN_DIR}/hypr/{sig}/.socket.sock"
    if os.path.exists(sock_path):
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(0.2)
                s.connect(sock_path)
                s.sendall(b"j/activeworkspace")
                chunks = []
                while True:
                    data = s.recv(4096)
                    if not data:
                        break
                    chunks.append(data)
            ws_data = json.loads(b"".join(chunks).decode())
            lm = (ws_data.get("tiledLayout") or "").lower()
            if lm in ("dwindle", "scrolling", "master", "monocle"):
                layout_mode = lm
        except Exception:
            pass

print(
    json.dumps(
        {
            "cpu_pct": cpu_pct,
            "cpu_temp": cpu_temp,
            "mem_pct": mem_pct,
            "mem_used_gb": mem_used_gb,
            "mem_total_gb": mem_total_gb,
            "gpu_state": gpu_state,
            "gpu_driver": gpu_driver,
            "nvidia_pkg_installed": nvidia_pkg_installed,
            "nvidia_mod_indexed": nvidia_mod_indexed,
            "gpu_temp": gpu_temp,
            "gpu_util": gpu_util,
            "gpu_vram": gpu_vram,
            "bat_cap": bat_cap,
            "bat_status": bat_status,
            "bat_watts": bat_watts,
            "profile": profile,
            "brightness": bright,
            "volume": 50,
            "muted": False,
            "net_type": net_type,
            "net_name": net_name,
            "bt_on": bt_on,
            "night_light": night_light,
            "game_mode": game_mode,
            "im_engine": im_engine,
            "layout_mode": layout_mode,
        }
    )
)
