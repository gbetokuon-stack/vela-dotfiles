#!/usr/bin/env bash
# Vela Hardware Telemetry JSON for HP Victus (AMD Ryzen 7 7445HS + NVIDIA RTX 4050 Mobile)
# RTD3-safe: checks PCI runtime_status before touching nvidia-smi so RTX 4050 stays asleep on battery!

python3 - <<'PY'
import json, os, glob, subprocess, time

def read_file(p, default=""):
    try:
        with open(p) as f:
            return f.read().strip()
    except Exception:
        return default

# 1. CPU usage (short delta)
def cpu_times():
    parts = read_file("/proc/stat").splitlines()[0].split()[1:]
    nums = [int(x) for x in parts]
    idle = nums[3] + nums[4]
    total = sum(nums)
    return idle, total

i1, t1 = cpu_times()
time.sleep(0.12)
i2, t2 = cpu_times()
cpu_pct = round(100.0 * (1.0 - (i2 - i1) / max(1, (t2 - t1))))

# 2. CPU temp (AMD k10temp)
cpu_temp = 0
for hw in glob.glob("/sys/class/hwmon/hwmon*"):
    name = read_file(f"{hw}/name")
    if name in ("k10temp", "zenpower", "acpitz"):
        t = read_file(f"{hw}/temp1_input")
        if t.isdigit():
            cpu_temp = round(int(t) / 1000.0)
            if name == "k10temp":
                break

# 3. RAM
mem = {}
for line in read_file("/proc/meminfo").splitlines():
    k, v = line.split(":", 1)
    mem[k] = int(v.strip().split()[0])
mem_total = mem.get("MemTotal", 1)
mem_avail = mem.get("MemAvailable", 0)
mem_used_gb = round((mem_total - mem_avail) / 1048576.0, 1)
mem_total_gb = round(mem_total / 1048576.0, 1)
mem_pct = round(100.0 * (mem_total - mem_avail) / max(1, mem_total))

# 4. NVIDIA RTX 4050 RTD3-safe status
gpu_pci = "/sys/bus/pci/devices/0000:01:00.0"
gpu_rt = read_file(f"{gpu_pci}/power/runtime_status", "unknown")
gpu_driver = os.path.basename(os.path.realpath(f"{gpu_pci}/driver")) if os.path.exists(f"{gpu_pci}/driver") else "none"
gpu_state = "Sleep"
gpu_temp = 0
gpu_util = 0
gpu_vram = "0G"

if gpu_driver == "nvidia":
    if gpu_rt == "suspended":
        gpu_state = "D3cold"
    else:
        gpu_state = "Active"
        try:
            out = subprocess.check_output(
                ["nvidia-smi", "--query-gpu=temperature.gpu,utilization.gpu,memory.used,memory.total", "--format=csv,noheader,nounits"],
                stderr=subprocess.DEVNULL, timeout=1.0
            ).decode().strip()
            parts = [p.strip() for p in out.split(",")]
            if len(parts) >= 4:
                gpu_temp = int(parts[0])
                gpu_util = int(parts[1])
                gpu_vram = f"{round(int(parts[2])/1024, 1)}/{round(int(parts[3])/1024, 0):.0f}G"
        except Exception:
            pass
elif gpu_driver == "nouveau":
    gpu_state = "Nouveau"

nvidia_pkg_installed = os.path.exists("/usr/lib/modules/" + os.uname().release + "/extramodules/nvidia.ko.zst")
nvidia_mod_indexed = False
try:
    with open(f"/usr/lib/modules/{os.uname().release}/modules.dep") as f:
        nvidia_mod_indexed = "/nvidia.ko" in f.read()
except Exception:
    pass

# 5. Battery
bat_cap = int(read_file("/sys/class/power_supply/BAT0/capacity", "100") or "100")
bat_status = read_file("/sys/class/power_supply/BAT0/status", "Unknown")
bat_power_uw = read_file("/sys/class/power_supply/BAT0/power_now", "0")
bat_watts = round(int(bat_power_uw) / 1e6, 1) if bat_power_uw.isdigit() else 0.0

# 6. Power profile
try:
    profile = subprocess.check_output(["powerprofilesctl", "get"], stderr=subprocess.DEVNULL, timeout=1.0).decode().strip()
except Exception:
    profile = "balanced"

# 7. Brightness (amdgpu_bl2)
bright = 100
try:
    cur = int(read_file("/sys/class/backlight/amdgpu_bl2/brightness", "100"))
    mx = int(read_file("/sys/class/backlight/amdgpu_bl2/max_brightness", "255"))
    bright = round(100.0 * cur / max(1, mx))
except Exception:
    pass

# 8. Volume (wpctl)
vol = 50
muted = False
try:
    vout = subprocess.check_output(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], stderr=subprocess.DEVNULL, timeout=1.0).decode().strip()
    muted = "MUTED" in vout
    for tok in vout.split():
        try:
            vol = round(float(tok) * 100)
            break
        except ValueError:
            pass
except Exception:
    pass

# 9. Network (Wi-Fi / Ethernet)
net_type = "offline"
net_name = "Offline"
try:
    ip_out = subprocess.check_output(["ip", "-brief", "addr"], stderr=subprocess.DEVNULL, timeout=1.0).decode()
    for line in ip_out.splitlines():
        cols = line.split()
        if len(cols) >= 3 and cols[1] == "UP" and cols[0] != "lo":
            iface = cols[0]
            if iface.startswith("wl"):
                net_type = "wifi"
                net_name = iface
                try:
                    iw = subprocess.check_output(["iwctl", "station", iface, "show"], stderr=subprocess.DEVNULL, timeout=1.0).decode()
                    for l in iw.splitlines():
                        if "Connected network" in l:
                            net_name = l.split("Connected network", 1)[1].strip()
                            break
                except Exception:
                    pass
                break
            else:
                net_type = "ethernet"
                net_name = "Wired"
except Exception:
    pass

# 10. Bluetooth & Night Light
bt_on = False
try:
    bt_out = subprocess.check_output(["bluetoothctl", "show"], stderr=subprocess.DEVNULL, timeout=1.0).decode()
    bt_on = "Powered: yes" in bt_out
except Exception:
    pass

night_light = subprocess.run(["pgrep", "-x", "hyprsunset"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
game_mode = os.path.exists(os.path.expanduser("~/.cache/vela/gamemode"))

# 11. Input Method (Fcitx5 EN/VN)
im_engine = ""
try:
    im_raw = subprocess.check_output(["fcitx5-remote", "-n"], stderr=subprocess.DEVNULL, timeout=0.6).decode().strip().lower()
    if any(k in im_raw for k in ("unikey", "bamboo", "vi")):
        im_engine = "VN"
    elif im_raw:
        im_engine = "EN"
except Exception:
    im_engine = ""

print(json.dumps({
    "cpu_pct": cpu_pct,
    "cpu_temp": cpu_temp,
    "mem_pct": mem_pct,
    "mem_used_gb": mem_used_gb,
    "mem_total_gb": mem_total_gb,
    "gpu_state": gpu_state,
    "gpu_driver": gpu_driver,
    "nvidia_pkg_installed": nvidia_pkg_installed,
    "nvidia_mod_indexed": nvidia_mod_indexed,
    "gpu_temp": gpu_temp,
    "gpu_util": gpu_util,
    "gpu_vram": gpu_vram,
    "bat_cap": bat_cap,
    "bat_status": bat_status,
    "bat_watts": bat_watts,
    "profile": profile,
    "brightness": bright,
    "volume": vol,
    "muted": muted,
    "net_type": net_type,
    "net_name": net_name,
    "bt_on": bt_on,
    "night_light": night_light,
    "game_mode": game_mode,
    "im_engine": im_engine,
}))
PY
