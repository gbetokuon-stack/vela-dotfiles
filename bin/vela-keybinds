    ("y = 40", "Mở rộng chiều dọc cửa sổ"),
    ("window.center", "Center Floating Window"),
    ("window.swap", "Swap Window Direction"),
    ("window.drag", "Drag Window (Mouse)"),
    ("window.resize", "Resize Window (Mouse)"),
