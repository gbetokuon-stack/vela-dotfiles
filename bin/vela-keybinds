#!/usr/bin/env python3
# =============================================================================
#  vela-keybinds — Live Parser for ~/.config/hypr/keybinds.lua -> JSON
# =============================================================================
import json
import os
import re

KB_FILE = os.path.expanduser("~/.config/hypr/keybinds.lua")

ACTION_LABELS = [
    ("launcher toggle", "Toggle App Launcher / Spotlight"),
    ("settings toggle", "Toggle Vela Rice Studio"),
    ("deck toggle", "Toggle Vela Command Deck"),
    ("wallpaper toggle", "Toggle Wallpaper & Matugen Studio"),
    ("clipboard toggle", "Toggle Native Clipboard Manager"),
    ("cheatsheet toggle", "Toggle Keybind Cheatsheet"),
    ("dock studio", "Open Vela Dock Studio (6 Presets & Live Config)"),
    ("dock cycleStyle", "Cycle Dock Design Style (Prism/macOS/Island/Cyber/Taskbar/Minimal)"),
    ("dock toggle", "Toggle Dock Visibility On / Off"),
    ("power toggle", "Toggle Power Menu"),
    ("vela-theme --random-all", "Random Wallpaper + Matugen Scheme"),
    ("vela-theme --random", "Random Wallpaper + Palette"),
    ("vela-theme --mode toggle", "Toggle Dark / Light Mode"),
    ("vela-clip", "Open Clipboard Manager"),
    ("vela-gamemode", "Toggle 144Hz Game Mode"),
