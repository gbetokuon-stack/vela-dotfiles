def describe(rhs):
    for pat, label in ACTION_LABELS:
        if pat in rhs:
            return label
    m = re.search(r'exec_cmd\("([^"]+)"\)', rhs)
    if m:
        return m.group(1)
    return rhs.strip()


def format_keys(expr):
    k = expr.replace('mod .. "', "SUPER").replace('"', "").strip()
    k = re.sub(r"\s*\+\s*", " + ", k)
    return k


def main():
    entries = []
    category = "General"
    if not os.path.exists(KB_FILE):
        print("[]")
        return

    with open(KB_FILE, encoding="utf-8") as f:
        lines = f.read().splitlines()

    for line in lines:
        s = line.strip()
        if s.startswith("-- ") and not s.startswith("-- Vela Keybindings"):
            title = s[3:].split("(")[0].strip()
            if "Start / App Search" in title or "Rice Settings" in title:
                title = "Vela Shell & Overlays"
            elif "Volume & Brightness" in title:
                title = "Audio & Brightness"
            elif "Workspaces" in title:
                title = "Workspaces"
            if title:
                category = title
            continue

        if "for i = 1, 10 do" in s:
            entries.append({"category": "Workspaces", "keys": "SUPER + 1..0", "desc": "Switch to Workspace 1–10"})
            entries.append({"category": "Workspaces", "keys": "SUPER + SHIFT + 1..0", "desc": "Move Active Window to Workspace 1–10"})
            continue

        m = re.match(r'^hl\.bind\(([^,]+),\s*(.+)\)$', s)
        if m:
            raw_key = m.group(1).strip()
            if "key" in raw_key:
                continue
            rhs = m.group(2).strip()
            entries.append({
                "category": category,
                "keys": format_keys(raw_key),
                "desc": describe(rhs),
            })

    print(json.dumps(entries))


if __name__ == "__main__":
    main()
