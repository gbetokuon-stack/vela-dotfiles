{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": {
            "1": "cyan",
            "2": "magenta"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "key": {
            "width": 12
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "cyan",
                "at": "dim_white",
                "host": "magenta"
            }
        },
        {
            "type": "separator",
            "string": "─"
        },
        { "type": "os",       "key": "󰣇 OS",      "keyColor": "cyan" },
        { "type": "kernel",   "key": "󰒋 Kernel",  "keyColor": "cyan" },
        { "type": "wm",       "key": "󰖲 WM",      "keyColor": "magenta" },
        { "type": "shell",    "key": "󰆍 Shell",   "keyColor": "magenta" },
        { "type": "display",  "key": "󰍹 Display", "keyColor": "blue" },
        { "type": "cpu",      "key": "󰻠 CPU",     "keyColor": "blue" },
        { "type": "gpu",      "key": "󰢮 GPU",     "keyColor": "green" },
        { "type": "memory",   "key": "󰍛 Memory",  "keyColor": "yellow" },
        { "type": "battery",  "key": "󰁹 Battery", "keyColor": "yellow" },
        { "type": "uptime",   "key": "󰅐 Uptime",  "keyColor": "white" },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
