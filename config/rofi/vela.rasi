@import "colors.rasi"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "◆";
    display-run: "❯";
    display-window: "❖";
    drun-display-format: "{name}";
    font: "Inter 11";
}

* {
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
}

window {
    width: 620px;
    background-color: @bg;
    border: 1px solid;
    border-color: @border-col;
    border-radius: 24px;
    padding: 20px;
}

mainbox {
    spacing: 16px;
    children: [ inputbar, listview, mode-switcher ];
}

inputbar {
    background-color: @bg-card;
    border: 1px solid;
    border-color: @border-col;
    border-radius: 16px;
    padding: 12px 16px;
    spacing: 12px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 13";
    vertical-align: 0.5;
}

entry {
    placeholder: "Search apps, commands, or windows...";
    placeholder-color: @fg-muted;
    vertical-align: 0.5;
}

listview {
    columns: 2;
    lines: 6;
    spacing: 8px;
    cycle: true;
    dynamic: true;
    fixed-height: false;
}

element {
    padding: 10px 14px;
    spacing: 12px;
    border-radius: 14px;
    background-color: transparent;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @accent-soft;
    border: 1px solid;
    border-color: @border-col;
    text-color: @fg;
}

element-icon {
    size: 26px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}

mode-switcher {
    spacing: 8px;
}

button {
    padding: 8px 14px;
    border-radius: 12px;
    background-color: @bg-card;
    text-color: @fg-muted;
    font: "Inter Medium 10";
}

button selected {
    background-color: @accent;
    text-color: @accent-fg;
}
